{
  "name": "@agent-plugins/cli",
  "version": "0.1.0",
  "description": "Command-line interface for Agent Plugins Toolkit.",
  "type": "module",
  "bin": {
    "agent-plugin": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "tsc -b tsconfig.json && node --test test/**/*.test.mjs"
  },
  "dependencies": {
    "@agent-plugins/adapter-claude": "workspace:*",
    "@agent-plugins/adapter-codex": "workspace:*",
    "@agent-plugins/adapter-cursor": "workspace:*",
    "@agent-plugins/compiler": "workspace:*",
    "@agent-plugins/core": "workspace:*",
    "@agent-plugins/installer": "workspace:*"
  }
}
